# Never commit real Apple credentials or session data.
APPLE_ACCOUNT_ID=your-apple-id@example.com
APPLE_ACCOUNT_REGION=global
APPLE_BRIDGE_PYTHON=/absolute/path/to/.venv/bin/python
APPLE_BRIDGE_SESSION_DIR=/absolute/path/to/private/session-directory
# Apple credentials must not be placed in this repository. This file documents names only.
ICLOUD_APPLE_ID=
ICLOUD_REGION=china
ICLOUD_SESSION_DIRECTORY=~/.local/state/openclaw-apple-account/session
ICLOUD_PASSWORD_FILE=
ICLOUD_REQUEST_TIMEOUT_SECONDS=20

# Gmail messages from these accounts may contain a quoted original 12306 notice.
RAIL12306_TRUSTED_FORWARDERS=
RAIL12306_GMAIL_QUERY="12306 newer_than:30d"
RAIL12306_STATE_FILE=~/.local/state/openclaw-apple-account/rail12306.json
ICLOUD_CALENDAR_ID=
